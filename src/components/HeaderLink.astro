---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'> & { exact?: boolean };

const { href, class: className, exact = false, ...props } = Astro.props;
const normalizePath = (value: string) => {
	const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
	const path = base && value.startsWith(base) ? value.slice(base.length) : value;
	const trimmed = path.replace(/\/+$/, '');
	return trimmed === '' ? '/' : trimmed;
};

const pathname = normalizePath(Astro.url.pathname);
const normalizedHref = normalizePath(String(href));
const isActive =
	normalizedHref === pathname ||
	(!exact && normalizedHref !== '/' && pathname.startsWith(normalizedHref + '/'));
---

<a href={href} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
	a.active {
		font-weight: bolder;
		text-decoration: underline;
	}
</style>
